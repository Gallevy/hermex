{
  "packages": {
    "internal": ["@design-system/*"]
  },
  "versus": [
    {
      "name": "Design System Migration",
      "packages": ["@design-system/foundation", "@new-system/arc"]
    }
  ],
  "rules": {
    "forbid_files": [
      { "severity": "error", "patterns": ["jest.config.*", ".babelrc"], "message": "Use vitest + Vite" }
    ],
    "forbid_packages": [
      { "severity": "error", "patterns": ["moment"], "message": "Use date-fns or dayjs" }
    ],
    "require_files": { "severity": "error", "patterns": [".nvmrc"] },
    "allow_files": { "severity": "warn", "patterns": [".editorconfig"] }
  },
  "output": {
    "details": false,
    "patterns": false
  }
}
